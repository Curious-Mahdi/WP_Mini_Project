<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - DevSprint</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-5">
        <div class="card shadow-lg" style="background: white; border-radius: 24px; padding: 3rem;">
          <h2 class="text-center mb-4" style="font-weight: 700; font-size: 2rem; color: #1f2937;">
            <i class="fas fa-sign-in-alt me-2" style="color: #6366f1;"></i>Login
          </h2>
          
          <% if (error) { %>
            <div class="alert alert-danger" role="alert" style="background: #fee2e2; color: #991b1b; border-radius: 12px; padding: 1rem; margin-bottom: 1.5rem;">
              <%= error %>
            </div>
          <% } %>

          <form action="/auth/login" method="POST">
            <div class="mb-3">
              <label for="email" class="form-label" style="font-weight: 600; color: #374151;">
                <i class="fas fa-envelope me-2" style="color: #6366f1;"></i>Email
              </label>
              <input type="email" class="form-control" id="email" name="email" required style="padding: 0.75rem 1rem; border-radius: 12px; border: 2px solid #e5e7eb; font-size: 1rem;">
            </div>
            <div class="mb-4">
              <label for="password" class="form-label" style="font-weight: 600; color: #374151;">
                <i class="fas fa-lock me-2" style="color: #6366f1;"></i>Password
              </label>
              <input type="password" class="form-control" id="password" name="password" required style="padding: 0.75rem 1rem; border-radius: 12px; border: 2px solid #e5e7eb; font-size: 1rem;">
            </div>
            <div class="d-grid">
              <button type="submit" class="btn btn-primary btn-lg rounded-pill" style="padding: 0.875rem 2rem; font-size: 1.1rem; background: linear-gradient(135deg, #6366f1, #4f46e5); font-weight: 600;">
                Login
              </button>
            </div>
          </form>

          <div class="text-center mt-4">
            <p style="color: #6b7280;">Don't have an account? <a href="/auth/signup" style="color: #6366f1; font-weight: 600; text-decoration: none;">Sign Up</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

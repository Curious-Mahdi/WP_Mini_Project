<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Achievements - DevSprint</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('partials/header') %>

  <div class="container mt-5">
    <div class="text-center mb-5">
      <h2 style="color: #1f2937; font-weight: 700; font-size: 2.5rem; margin-bottom: 0.5rem;">
        <i class="fas fa-trophy me-2" style="color: #f59e0b;"></i>Achievements
      </h2>
      <p style="color: #6b7280; font-size: 1.1rem;">Track your learning milestones</p>
    </div>

    <!-- Stats Card -->
    <div class="row g-4 mb-5">
      <div class="col-md-4">
        <div class="card shadow-lg text-center" style="background: white; border-radius: 20px; padding: 2rem;">
          <i class="fas fa-book" style="font-size: 3rem; margin-bottom: 0.5rem; color: #6366f1;"></i>
          <div style="font-size: 2.5rem; font-weight: 800; color: #6366f1; margin-bottom: 0.5rem;"><%= stats.completedModules %></div>
          <p style="color: #6b7280; font-weight: 500;">Modules Completed</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card shadow-lg text-center" style="background: white; border-radius: 20px; padding: 2rem;">
          <i class="fas fa-star" style="font-size: 3rem; margin-bottom: 0.5rem; color: #f59e0b;"></i>
          <div style="font-size: 2.5rem; font-weight: 800; color: #f59e0b; margin-bottom: 0.5rem;"><%= stats.perfectScores %></div>
          <p style="color: #6b7280; font-weight: 500;">Perfect Scores</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card shadow-lg text-center" style="background: white; border-radius: 20px; padding: 2rem;">
          <i class="fas fa-bullseye" style="font-size: 3rem; margin-bottom: 0.5rem; color: #10b981;"></i>
          <div style="font-size: 2.5rem; font-weight: 800; color: #10b981; margin-bottom: 0.5rem;"><%= stats.totalScore %></div>
          <p style="color: #6b7280; font-weight: 500;">Total Points</p>
        </div>
      </div>
    </div>

    <!-- Achievements Grid -->
    <div class="row g-4">
      <% achievements.forEach((achievement) => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-lg h-100" style="background: <%= achievement.earned ? 'linear-gradient(135deg, #fef3c7, #fde68a)' : '#f3f4f6' %>; border-radius: 20px; padding: 2rem; text-align: center; border: <%= achievement.earned ? '3px solid #f59e0b' : '2px solid #e5e7eb' %>;">
            <i class="<%= achievement.icon === '🎯' ? 'fas fa-bullseye' : achievement.icon === '⭐' ? 'fas fa-star' : achievement.icon === '🏆' ? 'fas fa-trophy' : achievement.icon === '👑' ? 'fas fa-crown' : 'fas fa-award' %>" style="font-size: 4rem; margin-bottom: 1rem; opacity: <%= achievement.earned ? '1' : '0.3' %>; color: <%= achievement.earned ? '#f59e0b' : '#9ca3af' %>;"></i>
            <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 0.5rem; color: #1f2937;"><%= achievement.name %></h4>
            <p style="color: #6b7280; font-size: 0.95rem; margin-bottom: 1rem;"><%= achievement.description %></p>
            <% if (achievement.earned) { %>
              <span class="badge" style="background: #10b981; color: white; padding: 0.5rem 1rem; font-size: 0.875rem;">
                <i class="fas fa-check me-1"></i>Earned
              </span>
            <% } else { %>
              <span class="badge" style="background: #9ca3af; color: white; padding: 0.5rem 1rem; font-size: 0.875rem;">
                <i class="fas fa-lock me-1"></i>Locked
              </span>
            <% } %>
          </div>
        </div>
      <% }); %>

      <!-- Locked Achievements -->
      <% if (achievements.length < 4) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-lg h-100" style="background: #f3f4f6; border-radius: 20px; padding: 2rem; text-align: center; border: 2px solid #e5e7eb;">
            <i class="fas fa-fire" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.3; color: #9ca3af;"></i>
            <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 0.5rem; color: #1f2937;">7 Day Streak</h4>
            <p style="color: #6b7280; font-size: 0.95rem; margin-bottom: 1rem;">Study for 7 days in a row!</p>
            <span class="badge" style="background: #9ca3af; color: white; padding: 0.5rem 1rem; font-size: 0.875rem;">
              <i class="fas fa-lock me-1"></i>Locked
            </span>
          </div>
        </div>
      <% } %>
    </div>

    <div class="text-center mt-5">
      <a href="/learning/modules" class="btn btn-primary rounded-pill" style="padding: 0.875rem 2rem; background: linear-gradient(135deg, #6366f1, #4f46e5);">
        <i class="fas fa-arrow-left me-2"></i>Back to Modules
      </a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

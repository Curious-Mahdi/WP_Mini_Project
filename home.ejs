<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DevSprint - Learn Web Development</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-8 text-center">
        <h1 style="font-size: 4rem; font-weight: 800; margin-bottom: 1rem; background: linear-gradient(135deg, #6366f1, #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
          <i class="fas fa-rocket me-3" style="color: #6366f1;"></i>DevSprint
        </h1>
        <p style="font-size: 1.5rem; color: #4b5563; font-weight: 500; margin-bottom: 3rem;">
          Master web development fundamentals with interactive flashcards and quizzes!
        </p>
        
        <div class="card shadow-lg" style="background: white; border-radius: 24px; padding: 3rem; margin-bottom: 3rem;">
          <h3 style="font-weight: 700; font-size: 1.75rem; margin-bottom: 2rem; color: #1f2937;">Get Started</h3>
          <div class="d-grid gap-3">
            <a href="/auth/signup" class="btn btn-primary btn-lg rounded-pill" style="padding: 1rem 2rem; font-size: 1.1rem; background: linear-gradient(135deg, #6366f1, #4f46e5);">
              Sign Up
            </a>
            <a href="/auth/login" class="btn btn-outline-primary btn-lg rounded-pill" style="padding: 1rem 2rem; font-size: 1.1rem; border: 2px solid #6366f1; color: #6366f1;">
              Login
            </a>
          </div>
        </div>

        <div style="background: white; border-radius: 24px; padding: 2.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <h5 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 2rem; color: #1f2937;">Features</h5>
          <div class="row text-start">
            <div class="col-md-4 mb-4">
              <div class="text-center">
                <i class="fas fa-book" style="font-size: 3.5rem; margin-bottom: 1rem; color: #6366f1;"></i>
                <strong style="font-size: 1.25rem; color: #1f2937; display: block; margin-bottom: 0.5rem;">5 Modules</strong>
                <p style="color: #6b7280; font-size: 0.95rem;">HTML, CSS, JavaScript, React, Node.js</p>
              </div>
            </div>
            <div class="col-md-4 mb-4">
              <div class="text-center">
                <i class="fas fa-clone" style="font-size: 3.5rem; margin-bottom: 1rem; color: #10b981;"></i>
                <strong style="font-size: 1.25rem; color: #1f2937; display: block; margin-bottom: 0.5rem;">Flashcards</strong>
                <p style="color: #6b7280; font-size: 0.95rem;">Interactive 3D flip learning</p>
              </div>
            </div>
            <div class="col-md-4 mb-4">
              <div class="text-center">
                <i class="fas fa-question-circle" style="font-size: 3.5rem; margin-bottom: 1rem; color: #f59e0b;"></i>
                <strong style="font-size: 1.25rem; color: #1f2937; display: block; margin-bottom: 0.5rem;">Quizzes</strong>
                <p style="color: #6b7280; font-size: 0.95rem;">Test your knowledge</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Study Guide - DevSprint</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('partials/header') %>

  <div class="container mt-5">
    <div class="text-center mb-5">
      <h2 style="color: #1f2937; font-weight: 700; font-size: 2.5rem; margin-bottom: 0.5rem;">
        <i class="fas fa-graduation-cap me-2" style="color: #6366f1;"></i>Study Guide
      </h2>
      <p style="color: #6b7280; font-size: 1.1rem;">Essential resources for web development</p>
    </div>

    <div class="row g-4">
      <div class="col-md-6">
        <div class="card shadow-lg h-100" style="background: white; border-radius: 20px; padding: 2rem;">
          <i class="fab fa-html5" style="font-size: 3rem; margin-bottom: 1rem; color: #e34c26;"></i>
          <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem; color: #1f2937;">HTML Resources</h4>
          <ul style="list-style: none; padding: 0;">
            <li style="margin-bottom: 0.75rem;">
              <a href="https://developer.mozilla.org/en-US/docs/Web/HTML" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>MDN HTML Documentation
              </a>
            </li>
            <li style="margin-bottom: 0.75rem;">
              <a href="https://www.w3schools.com/html/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>W3Schools HTML Tutorial
              </a>
            </li>
            <li style="margin-bottom: 0.75rem;">
              <a href="https://html.spec.whatwg.org/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>HTML Living Standard
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card shadow-lg h-100" style="background: white; border-radius: 20px; padding: 2rem;">
          <i class="fab fa-css3-alt" style="font-size: 3rem; margin-bottom: 1rem; color: #264de4;"></i>
          <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem; color: #1f2937;">CSS Resources</h4>
          <ul style="list-style: none; padding: 0;">
            <li style="margin-bottom: 0.75rem;">
              <a href="https://developer.mozilla.org/en-US/docs/Web/CSS" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>MDN CSS Documentation
              </a>
            </li>
            <li style="margin-bottom: 0.75rem;">
              <a href="https://css-tricks.com/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>CSS-Tricks
              </a>
            </li>
            <li style="margin-bottom: 0.75rem;">
              <a href="https://flexboxfroggy.com/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>Flexbox Froggy (Game)
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card shadow-lg h-100" style="background: white; border-radius: 20px; padding: 2rem;">
          <i class="fab fa-js-square" style="font-size: 3rem; margin-bottom: 1rem; color: #f7df1e;"></i>
          <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem; color: #1f2937;">JavaScript Resources</h4>
          <ul style="list-style: none; padding: 0;">
            <li style="margin-bottom: 0.75rem;">
              <a href="https://developer.mozilla.org/en-US/docs/Web/JavaScript" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>MDN JavaScript Guide
              </a>
            </li>
            <li style="margin-bottom: 0.75rem;">
              <a href="https://javascript.info/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>JavaScript.info
              </a>
            </li>
            <li style="margin-bottom: 0.75rem;">
              <a href="https://eloquentjavascript.net/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>Eloquent JavaScript (Book)
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card shadow-lg h-100" style="background: white; border-radius: 20px; padding: 2rem;">
          <i class="fab fa-react" style="font-size: 3rem; margin-bottom: 1rem; color: #61dafb;"></i>
          <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem; color: #1f2937;">React Resources</h4>
          <ul style="list-style: none; padding: 0;">
            <li style="margin-bottom: 0.75rem;">
              <a href="https://react.dev/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>React Official Docs
              </a>
            </li>
            <li style="margin-bottom: 0.75rem;">
              <a href="https://reactrouter.com/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>React Router
              </a>
            </li>
            <li style="margin-bottom: 0.75rem;">
              <a href="https://beta.reactjs.org/learn" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                <i class="fas fa-external-link-alt me-2"></i>React Learn
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="col-md-12">
        <div class="card shadow-lg" style="background: white; border-radius: 20px; padding: 2rem;">
          <i class="fab fa-node-js" style="font-size: 3rem; margin-bottom: 1rem; color: #339933;"></i>
          <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem; color: #1f2937;">Node.js Resources</h4>
          <div class="row">
            <div class="col-md-6">
              <ul style="list-style: none; padding: 0;">
                <li style="margin-bottom: 0.75rem;">
                  <a href="https://nodejs.org/en/docs/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                    <i class="fas fa-external-link-alt me-2"></i>Node.js Official Docs
                  </a>
                </li>
                <li style="margin-bottom: 0.75rem;">
                  <a href="https://expressjs.com/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                    <i class="fas fa-external-link-alt me-2"></i>Express.js Guide
                  </a>
                </li>
              </ul>
            </div>
            <div class="col-md-6">
              <ul style="list-style: none; padding: 0;">
                <li style="margin-bottom: 0.75rem;">
                  <a href="https://mongoosejs.com/docs/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                    <i class="fas fa-external-link-alt me-2"></i>Mongoose Documentation
                  </a>
                </li>
                <li style="margin-bottom: 0.75rem;">
                  <a href="https://www.mongodb.com/docs/" target="_blank" style="color: #6366f1; text-decoration: none; font-weight: 500;">
                    <i class="fas fa-external-link-alt me-2"></i>MongoDB Docs
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center mt-5">
      <a href="/learning/modules" class="btn btn-primary rounded-pill" style="padding: 0.875rem 2rem; background: linear-gradient(135deg, #6366f1, #4f46e5);">
        <i class="fas fa-arrow-left me-2"></i>Back to Modules
      </a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz Result - DevSprint</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
</head>
<body>
  <%- include('partials/header') %>

  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card shadow-lg text-center result-container" style="background: white; border-radius: 24px; padding: 3rem;">
          <div style="font-size: 4rem; margin-bottom: 1rem;">
            <% if (score === total) { %>
              <i class="fas fa-trophy" style="color: #f59e0b;"></i>
            <% } else if (score >= total * 0.7) { %>
              <i class="fas fa-thumbs-up" style="color: #10b981;"></i>
            <% } else { %>
              <i class="fas fa-dumbbell" style="color: #6366f1;"></i>
            <% } %>
          </div>
          <h2 style="font-weight: 700; font-size: 2rem; margin-bottom: 1rem; color: #1f2937;"><%= moduleName %> Quiz Result</h2>
          <div style="font-size: 4rem; font-weight: 800; margin-bottom: 1.5rem; background: linear-gradient(135deg, #6366f1, #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
            <%= score %> / <%= total %>
          </div>
          <div class="mb-4">
            <div class="progress" style="height: 20px; border-radius: 12px; background: #e5e7eb; overflow: hidden;">
              <div class="progress-bar bg-primary" role="progressbar" style="width: <%= percentage %>%; background: linear-gradient(90deg, #6366f1, #3b82f6); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600;">
                <%= percentage %>%
              </div>
            </div>
          </div>
          <p style="font-size: 1.25rem; font-weight: 500; margin-bottom: 2rem; color: #4b5563;"><%= message %></p>

          <div class="d-grid gap-2 d-md-block">
            <a href="/learning/review/<%= module %>" class="btn btn-primary btn-lg rounded-pill me-2 mb-2" style="padding: 1rem 2rem; font-size: 1.1rem; background: linear-gradient(135deg, #10b981, #059669); border: none;">
              <i class="fas fa-book-open me-2"></i>View Answers
            </a>
            <a href="/learning/practice/<%= module %>" class="btn btn-outline-primary btn-lg rounded-pill me-2 mb-2" style="padding: 1rem 2rem; font-size: 1.1rem; background: white; color: #6366f1; border: 2px solid #6366f1;">
              <i class="fas fa-redo me-2"></i>Practice Mistakes
            </a>
            <a href="/learning/quiz/<%= module %>" class="btn btn-outline-primary btn-lg rounded-pill me-2 mb-2" style="padding: 1rem 2rem; font-size: 1.1rem; background: white; color: #6366f1; border: 2px solid #6366f1;">
              <i class="fas fa-redo me-2"></i>Retry Quiz
            </a>
            <a href="/learning/modules" class="btn btn-primary btn-lg rounded-pill" style="padding: 1rem 2rem; font-size: 1.1rem; background: linear-gradient(135deg, #6366f1, #4f46e5);">
              <i class="fas fa-arrow-left me-2"></i>Back to Modules
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Play confetti on perfect score
    const score = <%= score %>;
    const total = <%= total %>;
    
    if (score === total && typeof confetti !== 'undefined') {
      // Trigger confetti celebration
      const duration = 3000;
      const end = Date.now() + duration;

      (function frame() {
        confetti({
          particleCount: 2,
          angle: 60,
          spread: 55,
          origin: { x: 0 },
          colors: ['#6366f1', '#3b82f6', '#10b981', '#f59e0b']
        });
        confetti({
          particleCount: 2,
          angle: 120,
          spread: 55,
          origin: { x: 1 },
          colors: ['#6366f1', '#3b82f6', '#10b981', '#f59e0b']
        });

        if (Date.now() < end) {
          requestAnimationFrame(frame);
        }
      }());
      
      // Additional burst
      setTimeout(() => {
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 },
          colors: ['#6366f1', '#3b82f6', '#10b981', '#f59e0b']
        });
      }, 500);
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

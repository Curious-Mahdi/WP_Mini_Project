<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Progress - DevSprint</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('partials/header') %>

  <div class="container mt-5">
    <div class="text-center mb-5">
      <h2 style="color: #1f2937; font-weight: 700; font-size: 2.5rem; margin-bottom: 0.5rem;">
        <i class="fas fa-chart-line me-2" style="color: #6366f1;"></i>Your Progress
      </h2>
      <p style="color: #6b7280; font-size: 1.1rem;">Track your learning journey</p>
    </div>

    <div class="row g-4">
      <div class="col-md-4">
        <div class="card shadow-lg h-100" style="background: white; border-radius: 20px; padding: 2rem; text-align: center;">
          <i class="fab fa-html5" style="font-size: 3.5rem; margin-bottom: 1rem; color: #e34c26;"></i>
          <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;">HTML</h4>
          <% if (progress.html.completed) { %>
            <span class="badge bg-success rounded-pill mb-3 px-3 py-2" style="background: #10b981; color: white; font-size: 0.875rem; padding: 0.5rem 1rem;">
              <i class="fas fa-check me-1"></i>Completed
            </span>
            <div class="mt-3">
              <strong style="font-size: 2.5rem; font-weight: 800; color: #6366f1;"><%= progress.html.score %>/10</strong>
            </div>
          <% } else { %>
            <span class="badge bg-secondary rounded-pill mb-3 px-3 py-2" style="background: #e5e7eb; color: #6b7280; font-size: 0.875rem; padding: 0.5rem 1rem;">Not Started</span>
            <p style="color: #9ca3af; margin-top: 1rem;">Take the quiz to get started!</p>
          <% } %>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-lg h-100" style="background: white; border-radius: 20px; padding: 2rem; text-align: center;">
          <i class="fab fa-css3-alt" style="font-size: 3.5rem; margin-bottom: 1rem; color: #264de4;"></i>
          <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;">CSS</h4>
          <% if (progress.css.completed) { %>
            <span class="badge bg-success rounded-pill mb-3 px-3 py-2" style="background: #10b981; color: white; font-size: 0.875rem; padding: 0.5rem 1rem;">
              <i class="fas fa-check me-1"></i>Completed
            </span>
            <div class="mt-3">
              <strong style="font-size: 2.5rem; font-weight: 800; color: #6366f1;"><%= progress.css.score %>/10</strong>
            </div>
          <% } else { %>
            <span class="badge bg-secondary rounded-pill mb-3 px-3 py-2" style="background: #e5e7eb; color: #6b7280; font-size: 0.875rem; padding: 0.5rem 1rem;">Not Started</span>
            <p style="color: #9ca3af; margin-top: 1rem;">Take the quiz to get started!</p>
          <% } %>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-lg h-100" style="background: white; border-radius: 20px; padding: 2rem; text-align: center;">
          <i class="fab fa-js-square" style="font-size: 3.5rem; margin-bottom: 1rem; color: #f7df1e;"></i>
          <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;">JavaScript</h4>
          <% if (progress.js.completed) { %>
            <span class="badge bg-success rounded-pill mb-3 px-3 py-2" style="background: #10b981; color: white; font-size: 0.875rem; padding: 0.5rem 1rem;">
              <i class="fas fa-check me-1"></i>Completed
            </span>
            <div class="mt-3">
              <strong style="font-size: 2.5rem; font-weight: 800; color: #6366f1;"><%= progress.js.score %>/10</strong>
            </div>
          <% } else { %>
            <span class="badge bg-secondary rounded-pill mb-3 px-3 py-2" style="background: #e5e7eb; color: #6b7280; font-size: 0.875rem; padding: 0.5rem 1rem;">Not Started</span>
            <p style="color: #9ca3af; margin-top: 1rem;">Take the quiz to get started!</p>
          <% } %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card shadow-lg h-100" style="background: white; border-radius: 20px; padding: 2rem; text-align: center;">
          <i class="fab fa-react" style="font-size: 3.5rem; margin-bottom: 1rem; color: #61dafb;"></i>
          <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;">React</h4>
          <% if (progress.react && progress.react.completed) { %>
            <span class="badge bg-success rounded-pill mb-3 px-3 py-2" style="background: #10b981; color: white; font-size: 0.875rem; padding: 0.5rem 1rem;">
              <i class="fas fa-check me-1"></i>Completed
            </span>
            <div class="mt-3">
              <strong style="font-size: 2.5rem; font-weight: 800; color: #6366f1;"><%= progress.react.score %>/10</strong>
            </div>
          <% } else { %>
            <span class="badge bg-secondary rounded-pill mb-3 px-3 py-2" style="background: #e5e7eb; color: #6b7280; font-size: 0.875rem; padding: 0.5rem 1rem;">Not Started</span>
            <p style="color: #9ca3af; margin-top: 1rem;">Take the quiz to get started!</p>
          <% } %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card shadow-lg h-100" style="background: white; border-radius: 20px; padding: 2rem; text-align: center;">
          <i class="fab fa-node-js" style="font-size: 3.5rem; margin-bottom: 1rem; color: #339933;"></i>
          <h4 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;">Node.js</h4>
          <% if (progress.node && progress.node.completed) { %>
            <span class="badge bg-success rounded-pill mb-3 px-3 py-2" style="background: #10b981; color: white; font-size: 0.875rem; padding: 0.5rem 1rem;">
              <i class="fas fa-check me-1"></i>Completed
            </span>
            <div class="mt-3">
              <strong style="font-size: 2.5rem; font-weight: 800; color: #6366f1;"><%= progress.node.score %>/10</strong>
            </div>
          <% } else { %>
            <span class="badge bg-secondary rounded-pill mb-3 px-3 py-2" style="background: #e5e7eb; color: #6b7280; font-size: 0.875rem; padding: 0.5rem 1rem;">Not Started</span>
            <p style="color: #9ca3af; margin-top: 1rem;">Take the quiz to get started!</p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="text-center mt-5">
      <a href="/learning/modules" class="btn btn-primary rounded-pill" style="background: linear-gradient(135deg, #6366f1, #4f46e5); padding: 0.75rem 2rem; color: white;">
        <i class="fas fa-arrow-left me-2"></i>Back to Modules
      </a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
